Program 1 – Routing Algorithm Performance Comparison
clc; clear;
clf();

k = 1;

for n = 5:5:100
    nodes(k) = n;

    L = 1000;
    dmax = 100;

    [g] = NL_T_LocalityConnex(n, L, dmax);

    src = NL_F_RandInt1n(length(g.node_x));

    // Bellman-Ford timing
    for i = 1:20
        timer();
        [dist1, pred1] = NL_R_BellmanFord(g, src);
        T1(i) = timer();
    end

    bellman_time(k) = mean(T1);

    // Dijkstra timing
    for i = 1:20
        timer();
        [dist2, pred2] = NL_R_Dijkstra(g, src);
        T2(i) = timer();
    end

    dijkstra_time(k) = mean(T2);

    k = k + 1;
end

clf();
plot(nodes, bellman_time, '-ro');
plot(nodes, dijkstra_time, '-b*');

legend("Bellman-Ford", "Dijkstra");

xtitle("Routing Time Comparison");
xlabel("Number of Nodes");
ylabel("Time (seconds)");

xgrid();
