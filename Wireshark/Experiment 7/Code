Program 1 – Graph Generation (graphs.py)
from scapy.all import *
import matplotlib.pyplot as plt

packets = rdpcap("capture.pcapng")

def plot_packets(packet_list, title, position):
    plt.subplot(3,2,position)
    times = [pkt.time for pkt in packet_list]
    plt.hist(times, bins=50)
    plt.title(title)

plt.figure(figsize=(10,8))

plot_packets(packets, "All Packets", 1)
plot_packets([p for p in packets if TCP in p], "TCP Packets", 2)
plot_packets([p for p in packets if UDP in p], "UDP Packets", 3)
plot_packets([p for p in packets if p.haslayer(DNS)], "DNS Packets", 4)
plot_packets([p for p in packets if ICMP in p], "ICMP Packets", 5)

plt.tight_layout()
plt.show()
