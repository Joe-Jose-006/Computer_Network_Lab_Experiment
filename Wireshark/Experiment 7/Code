Program 2 – Protocol Analysis (protocol.py)
from scapy.all import *

packets = rdpcap("capture.pcapng")

total_packets = len(packets)
total_size = sum(len(pkt) for pkt in packets)

header_size = 0

for pkt in packets:
    if IP in pkt:
        header_size += pkt[IP].ihl * 4

data_size = total_size - header_size

print("Total number of packets:", total_packets)
print("Total size of data:", data_size, "bytes")
print("Total size of headers:", header_size, "bytes")
