Program 3 – Conversations Analysis (conversations.py)
from scapy.all import *
from collections import defaultdict
import statistics

packets = rdpcap("capture.pcapng")

flows = defaultdict(list)

max_bytes = 0
max_pair = None

for pkt in packets:
    if IP in pkt:
        key = (pkt[IP].src, pkt[IP].dst)
        flows[key].append(pkt)

for key, pkts in flows.items():
    total_bytes = sum(len(pkt) for pkt in pkts)
    total_packets = len(pkts)

    times = sorted([pkt.time for pkt in pkts])
    inter = [times[i+1] - times[i] for i in range(len(times)-1)]

    avg = statistics.mean(inter) if inter else 0

    if total_bytes > max_bytes:
        max_bytes = total_bytes
        max_pair = key

    print("Address Pair:", key)
    print("Total Bytes:", total_bytes)
    print("Total Packets:", total_packets)
    print("Average Inter Packet Time:", avg)
    print("--------------------------------")

print("Pair with Maximum Bytes:", max_pair)
print("Maximum Bytes Transferred:", max_bytes)
